  "itinerary_management": {
    "description": "Test examples for itinerary-related endpoints",
    
    "get_trip_itinerary": {
      "description": "GET /api/trips/{trip_id}/itinerary - Get detailed itinerary",
      "endpoint": "GET /api/trips/1/itinerary",
      "auth_required": true,
      "expected_response": {
        "trip_id": 1,
        "destination": "Paris, France",
        "itinerary": [
          {
            "day": 1,
            "date": "2024-07-15",
            "day_of_week": "Monday",
            "activities": [
              {
                "time": "10:00",
                "activity": "Arrive in Paris, France",
                "duration": "1 hour",
                "type": "travel"
              }
            ]
          }
        ],
        "summary": {
          "total_days": 8,
          "total_activities": 32,
          "activity_types": ["travel", "meal", "exploration", "morning", "afternoon", "evening"],
          "average_activities_per_day": 4.0
        }
      }
    },

    "generate_itinerary": {
      "description": "POST /api/trips/{trip_id}/itinerary/generate - Generate itinerary for existing trip",
      "examples": {
        "basic_generation": {
          "endpoint": "POST /api/trips/1/itinerary/generate",
          "data": {},
          "description": "Generate itinerary with auto-detected destination type"
        },
        
        "specify_destination_type": {
          "endpoint": "POST /api/trips/1/itinerary/generate",
          "data": {
            "destination_type": "beach",
            "replace_existing": true
          },
          "description": "Generate beach-type itinerary, replacing existing"
        },
        
        "cultural_itinerary": {
          "endpoint": "POST /api/trips/2/itinerary/generate",
          "data": {
            "destination_type": "cultural",
            "replace_existing": false
          },
          "description": "Generate cultural itinerary only if none exists"
        },
        
        "mountain_adventure": {
          "endpoint": "POST /api/trips/3/itinerary/generate",
          "data": {
            "destination_type": "mountain",
            "replace_existing": true
          },
          "description": "Generate mountain adventure itinerary"
        }
      }
    },

    "get_itinerary_templates": {
      "description": "GET /api/trips/itinerary/templates - Get available templates",
      "endpoint": "GET /api/trips/itinerary/templates",
      "auth_required": true,
      "expected_response": {
        "destination_types": ["city", "beach", "mountain", "cultural"],
        "trip_styles": {
          "relaxed": {
            "activities_per_day": 2,
            "pace": "slow",
            "break_time": "extended",
            "focus": ["relaxation", "leisure", "local_culture"]
          },
          "balanced": {
            "activities_per_day": 3,
            "pace": "moderate",
            "break_time": "regular",
            "focus": ["sightseeing", "culture", "food", "shopping"]
          },
          "adventurous": {
            "activities_per_day": 4,
            "pace": "fast",
            "break_time": "minimal",
            "focus": ["adventure", "sports", "exploration", "nightlife"]
          },
          "cultural": {
            "activities_per_day": 3,
            "pace": "moderate",
            "break_time": "regular",
            "focus": ["museums", "heritage", "traditions", "local_experiences"]
          }
        },
        "description": {
          "destination_types": "Available destination types for itinerary generation",
          "trip_styles": "Available trip styles with their characteristics"
        }
      }
    }
  },

  "test_scenarios": {
    "description": "Complete test scenarios with step-by-step instructions",
    
    "scenario_1_create_and_manage_trip": {
      "steps": [
        {
          "step": 1,
          "action": "POST /api/trips",
          "description": "Create a new trip with auto-generated itinerary",
          "data": {
            "destination": "Amsterdam, Netherlands",
            "start_date": "2024-08-15",
            "end_date": "2024-08-22",
            "latitude": 52.3676,
            "longitude": 4.9041,
            "description": "Summer trip to explore canals and museums",
            "budget": 2200.00,
            "status": "planned",
            "generate_itinerary": true
          },
          "expected_status": 201
        },
        {
          "step": 2,
          "action": "GET /api/trips/{trip_id}/itinerary",
          "description": "Retrieve the generated itinerary",
          "expected_status": 200
        },
        {
          "step": 3,
          "action": "PUT /api/trips/{trip_id}",
          "description": "Update trip to active status",
          "data": {
            "status": "active"
          },
          "expected_status": 200
        }
      ]
    },

    "scenario_3_itinerary_generation_workflow": {
      "description": "Test complete itinerary generation and management workflow",
      "steps": [
        {
          "step": 1,
          "action": "POST /api/trips",
          "description": "Create trip without itinerary",
          "data": {
            "destination": "Santorini, Greece",
            "start_date": "2024-09-01",
            "end_date": "2024-09-08",
            "latitude": 36.3932,
            "longitude": 25.4615,
            "description": "Greek island getaway",
            "budget": 2800.00,
            "status": "planned"
          },
          "expected_status": 201
        },
        {
          "step": 2,
          "action": "GET /api/trips/itinerary/templates",
          "description": "Get available itinerary templates",
          "expected_status": 200
        },
        {
          "step": 3,
          "action": "POST /api/trips/{trip_id}/itinerary/generate",
          "description": "Generate beach-style itinerary",
          "data": {
            "destination_type": "beach",
            "replace_existing": false
          },
          "expected_status": 200
        },
        {
          "step": 4,
          "action": "GET /api/trips/{trip_id}/itinerary",
          "description": "Verify generated itinerary",
          "expected_status": 200
        },
        {
          "step": 5,
          "action": "POST /api/trips/{trip_id}/itinerary/generate",
          "description": "Try to regenerate without replace flag",
          "data": {
            "destination_type": "cultural",
            "replace_existing": false
          },
          "expected_status": 409,
          "expected_error": "Itinerary already exists"
        },
        {
          "step": 6,
          "action": "POST /api/trips/{trip_id}/itinerary/generate",
          "description": "Force regenerate with cultural theme",
          "data": {
            "destination_type": "cultural",
            "replace_existing": true
          },
          "expected_status": 200
        }
      ]
    },

    "scenario_4_destination_type_detection": {
      "description": "Test automatic destination type detection",
      "steps": [
        {
          "step": 1,
          "action": "POST /api/trips",
          "description": "Create beach destination (should auto-detect)",
          "data": {
            "destination": "Maldives Beach Resort",
            "start_date": "2024-11-01",
            "end_date": "2024-11-07",
            "generate_itinerary": true
          },
          "expected_destination_type": "beach"
        },
        {
          "step": 2,
          "action": "POST /api/trips",
          "description": "Create mountain destination (should auto-detect)",
          "data": {
            "destination": "Himalayas Base Camp",
            "start_date": "2024-10-15",
            "end_date": "2024-10-25",
            "generate_itinerary": true
          },
          "expected_destination_type": "mountain"
        },
        {
          "step": 3,
          "action": "POST /api/trips",
          "description": "Create cultural destination (should auto-detect)",
          "data": {
            "destination": "Historic Temple Complex, Angkor Wat",
            "start_date": "2024-09-20",
            "end_date": "2024-09-27",
            "generate_itinerary": true
          },
          "expected_destination_type": "cultural"
        },
        {
          "step": 4,
          "action": "POST /api/trips",
          "description": "Create city destination (default)",
          "data": {
            "destination": "London, UK",
            "start_date": "2024-08-05",
            "end_date": "2024-08-10",
            "generate_itinerary": true
          },
          "expected_destination_type": "city"
        }
      ]
    }
  },
  
  "curl_examples": {
    "description": "Ready-to-use curl commands for testing",
    
    "create_trip_with_itinerary": {
      "command": "curl -X POST http://localhost:5000/api/trips \\\n  -H 'Content-Type: application/json' \\\n  -H 'Authorization: Bearer YOUR_TOKEN' \\\n  -d '{\n    \"destination\": \"Bali, Indonesia\",\n    \"start_date\": \"2024-08-01\",\n    \"end_date\": \"2024-08-07\",\n    \"description\": \"Beach vacation\",\n    \"budget\": 2000.00,\n    \"generate_itinerary\": true,\n    \"destination_type\": \"beach\"\n  }'"
    },

    "get_trip_itinerary": {
      "command": "curl -X GET http://localhost:5000/api/trips/1/itinerary \\\n  -H 'Authorization: Bearer YOUR_TOKEN'"
    },

    "generate_itinerary": {
      "command": "curl -X POST http://localhost:5000/api/trips/1/itinerary/generate \\\n  -H 'Content-Type: application/json' \\\n  -H 'Authorization: Bearer YOUR_TOKEN' \\\n  -d '{\n    \"destination_type\": \"cultural\",\n    \"replace_existing\": true\n  }'"
    },

    "get_itinerary_templates": {
      "command": "curl -X GET http://localhost:5000/api/trips/itinerary/templates \\\n  -H 'Authorization: Bearer YOUR_TOKEN'"
    }
  },

